# Domain publik situs. Dipakai untuk metadataBase, canonical URL, Open Graph,
# robots.txt, dan sitemap.xml. Tanpa trailing slash.
# Lokal boleh dikosongkan — default-nya http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://wacabajo.org

# Supabase — penyimpanan jawaban survei need assessment. Ambil dari dashboard
# Supabase: Project Settings → API. Anon key memang kunci publik; yang menjaga
# datanya adalah Row Level Security di supabase/schema.sql. Jangan pernah
# menaruh service role key di sini. Panduan lengkap: docs/SUPABASE.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tautan Google Form pendaftaran relawan/rekrutmen. Selama kosong, ajakan
# penutup hanya menampilkan email dan Instagram.
NEXT_PUBLIC_JOIN_FORM_URL=

# Pencatatan kunjungan mengabaikan localhost supaya angka di /backoffice tidak
# tercampur pekerjaan tim sendiri. Set 1 hanya kalau sedang menguji pencatatan
# itu dari mesin lokal.
NEXT_PUBLIC_TRACK_LOCAL=
